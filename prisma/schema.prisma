// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiAnalysisCache {
  id        String   @id @default(cuid())
  symbol    String
  date      String   // YYYY-MM-DD (for grouping/browsing)
  text      String
  ml        String   // JSON string of ML selection metadata
  price     Float
  priceHash String   @default("0") // Rounded price bucket (e.g. price rounded to 0.5%) for cache key
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, priceHash])
  @@index([symbol])
  @@index([date])
  @@index([createdAt])
}

model DecisionGraphAiCache {
  id        String   @id @default(cuid())
  symbol    String
  date      String   // YYYY-MM-DD (for grouping/browsing)
  text      String
  price     Float
  priceHash String   @default("0") // Rounded price bucket for cache key
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, priceHash])
  @@index([symbol])
  @@index([date])
  @@index([createdAt])
}

model TimeSeriesAnalysis {
  id            String   @id @default(cuid())
  symbol        String
  requestParams String   // JSON string of request parameters (forecast_steps, confidence, etc.)
  basicStats    String   // JSON string of basic statistics
  analysisJson  String   // Full analysis JSON result (decomposition, stationarity, etc.)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  results TimeSeriesResult[]

  @@index([symbol])
  @@index([createdAt])
}

model TimeSeriesResult {
  id            String   @id @default(cuid())
  analysisId    String   // Foreign key to TimeSeriesAnalysis
  model         String   // Forecast model name (e.g., 'arima', 'sarima', 'ets')
  forecastJson  String   // JSON array of forecast values with confidence intervals
  metricsJson   String   // JSON object of in-sample metrics (MAE, RMSE, MAPE, etc.)
  createdAt     DateTime @default(now())

  analysis TimeSeriesAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([model])
}