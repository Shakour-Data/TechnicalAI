  end ref
fork again
  ref over "API → Yahoo"
    دنباله: واکشی Yahoo
    (SEQ-FetchYahoo)
  end ref
end fork

if (همه منابع شکست؟) then (بله)
  loop [تا ۲ تلاش]
    ref over "API → FallbackSources"
      دنباله: واکشی جایگزین
      (SEQ-FallbackFetch)
    end ref
  end
  if (هنوز شکست) then (بله)
