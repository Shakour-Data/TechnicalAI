  end ref
  if (جایگزین موفق؟) then (خیر)
    :خطا;
    stop
  endif
endif

ref over "API → TA Engine"
  دنباله: محاسبه شاخص‌ها
  (SEQ-ComputeIndicators)
end ref

ref over "API → Regime Engine"
  دنباله: تشخیص رژیم
  (SEQ-DetectRegime)
end ref

switch (نوع رژیم)
case (صعودی)
  ref over "TA → DecisionGraph"
    دنباله: تحلیل صعودی
    (SEQ-BullishAnalysis)
  end ref
case (نزولی)
  ref over "TA → DecisionGraph"
    دنباله: تحلیل نزولی
    (SEQ-BearishAnalysis)
  end ref
case (رنج)
  ref over "TA → DecisionGraph"
    دنباله: تحلیل رنج
    (SEQ-RangeAnalysis)
  end ref
endswitch

ref over "API → MSLV4 → ZaiSDK"
  دنباله: تولید AI
  (SEQ-AIGeneration)
end ref

if (AI موفق؟) then (خیر - 429)
  ref over "API → RuleEngine"
    دنباله: تحلیل قاعده‌محور
    (SEQ-RuleBasedFallback)
  end ref
endif

:تجمیع و نمایش نتایج;
stop

@enduml
===DIAGRAM_END===


