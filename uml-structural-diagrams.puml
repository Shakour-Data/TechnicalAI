interface IAnalysisService <<provided>> {
  +analyze(symbol: string, period: Period): Promise<AnalysisResult>
  +getIndicators(symbol: string): Promise<IndicatorResult[]>
  +getTrend(symbol: string): Promise<TrendResult>
